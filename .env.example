 
# Required for Production Mode (Gemma 4 via Gemini API).
# Set this same name in Vercel: Settings → Environment Variables.
# Locally, put your real key in a file named .env (gitignored).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Local server port (server.ts defaults to 3000 if unset).
PORT=3000
