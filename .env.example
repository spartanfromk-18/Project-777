# ScamShield environment template
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — the real key lives ONLY on the machine running the backend.

# Required for Production Mode / MODE=api (Gemma 4 via Gemini API).
# Set this same name in Vercel: Settings -> Environment Variables.
# Get it from https://aistudio.google.com/ (Google AI Studio).
# Never put this key in frontend code, in git, or in a screenshot.
GEMINI_API_KEY=

# Engine mode: "api" (production, Gemini API) or "local" (offline fallback, Ollama).
MODE=api

# Local server port (server.ts and the backend server.js both default to 3000 if unset).
PORT=3000

# Optional backend overrides (defaults shown)
# GEMINI_MODEL=gemma-4-26b-a4b-it
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELS=gemma4:e4b,gemma4:e2b
# MAX_MESSAGE_LENGTH=2000
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000
